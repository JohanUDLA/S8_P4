<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="S8_P4.MainPage">
    <StackLayout Padding="20" Spacing="10">
        <Label Text="Suma de Dos Números"
               FontSize="24"
               TextColor="Purple"
               HorizontalOptions="CenterAndExpand"
               VerticalOptions="CenterAndExpand" />
        <Entry x:Name="txtNumero1"
               Placeholder="Número 1"
               Keyboard="Numeric"
               FontSize="18"
               HorizontalOptions="CenterAndExpand" />
        <Entry x:Name="txtNumero2"
               Placeholder="Número 2"
               Keyboard="Numeric"
               FontSize="18"
               HorizontalOptions="CenterAndExpand" />
        <Button Text="Sumar"
                Clicked="Sumar_Clicked"
                BackgroundColor="Purple"
                TextColor="White"
                HorizontalOptions="CenterAndExpand" />
        <Button Text="Restar"
                Clicked="Restar_Clicked"
                BackgroundColor="Blue"
                TextColor="White"
                HorizontalOptions="CenterAndExpand" />
        <Button Text="Multiplicar"
                Clicked="Multiplicar_Clicked"
                BackgroundColor="Green"
                TextColor="White"
                HorizontalOptions="CenterAndExpand" />
        <Button Text="Dividir"
                Clicked="Dividir_Clicked"
                BackgroundColor="Orange"
                TextColor="White"
                HorizontalOptions="CenterAndExpand" />
        <Label x:Name="lblResultado"
               FontSize="20"
               TextColor="Black"
               HorizontalOptions="CenterAndExpand"
               VerticalOptions="CenterAndExpand" />
    </StackLayout>
</ContentPage>